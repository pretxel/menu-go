{
  "$schema": "https://v2-8-20.turborepo.dev/schema.json",
  "globalDependencies": [
    "**/.env"
  ],
  "globalEnv": [
    "BLOB_READ_WRITE_TOKEN",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NODE_ENV",
    "OPENAI_API_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "VERCEL",
    "VERCEL_URL"
  ],
  "tasks": {
    "db:seed": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "build/**",
        "dist/**",
        ".next/**"
      ]
    },
    "lint": {
      "outputs": [],
      "cache": false
    },
    "lint:fix": {
      "outputs": []
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "develop": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "start": {
      "cache": true
    },
    "ci": {
      "cache": false
    }
  }
}
