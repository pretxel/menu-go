{
  "$schema": "https://v2-8-20.turborepo.dev/schema.json",
  "globalDependencies": [
    "**/.env"
  ],
  "globalEnv": [
    "BLOB_READ_WRITE_TOKEN",
    "DATABASE_URL",
    "DIRECT_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "NODE_ENV",
    "OPENAI_API_KEY",
    "VERCEL",
    "VERCEL_URL"
  ],
  "tasks": {
    "db:generate": {
      "inputs": [
        "prisma/schema.prisma"
      ],
      "cache": false
    },
    "db:push": {
      "inputs": [
        "prisma/schema.prisma"
      ],
      "cache": false
    },
    "db:seed": {
      "inputs": [
        "prisma/schema.prisma"
      ],
      "cache": false
    },
    "db:reset": {
      "inputs": [
        "prisma/schema.prisma"
      ],
      "cache": false
    },
    "db:migrate": {
      "inputs": [
        "prisma/schema.prisma"
      ],
      "cache": false
    },
    "build": {
      "dependsOn": [
        "db:generate",
        "^build"
      ],
      "outputs": [
        "build/**",
        "dist/**",
        ".next/**"
      ]
    },
    "lint": {
      "outputs": [],
      "cache": false
    },
    "lint:fix": {
      "outputs": []
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "develop": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "start": {
      "cache": true
    },
    "ci": {
      "cache": false
    }
  }
}
