{
  "name": "db",
  "version": "0.1.0",
  "main": "./index.ts",
  "types": "./index.ts",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "db:generate": "prisma generate",
    "db:push": "node scripts/guard-shared-db.mjs && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/guard-shared-db.mjs && prisma migrate reset --force",
    "db:migrate:dev": "node scripts/guard-shared-db.mjs && prisma migrate dev --create-only",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio --port 5557",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "ts-jest": "^29.4.15",
    "tsconfig": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
