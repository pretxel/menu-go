{
  "name": "db",
  "version": "0.1.0",
  "main": "./index.ts",
  "types": "./index.ts",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate --accept-data-loss",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:migrate:dev": "prisma migrate dev --create-only",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio --port 5557",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.6.0",
    "jest": "^29.5.0",
    "jest-environment-node": "^29.2.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.3",
    "prisma": "^5.6.0",
    "ts-node": "^10.9.1",
    "tsconfig": "*",
    "typescript": "5.1.6",
    "ts-jest": "^29.0.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
