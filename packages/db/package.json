{
  "name": "db",
  "version": "0.1.0",
  "main": "./index.ts",
  "types": "./index.ts",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate --accept-data-loss",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:migrate:dev": "prisma migrate dev --create-only",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio --port 5557",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "pg": "^8.20.0",
    "jest": "^30.3.0",
    "jest-environment-node": "^30.3.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.17",
    "prisma": "^7.8.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "tsconfig": "workspace:*",
    "typescript": "^6.0.3",
    "ts-jest": "^29.4.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
