FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
EMAIL_SERVER=""
EMAIL_FROM=""
# Postgres connection (Supabase recommended; local Docker works too)
# Runtime URL — Supabase: Supavisor transaction pooler (port 6543)
#   postgresql://<user>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local Docker: postgresql://postgres:secrect@localhost:5432/postgres
DATABASE_URL=
# Prisma CLI URL (push/migrate/seed) — Supabase: session pooler (port 5432)
#   postgresql://<user>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional: omit to reuse DATABASE_URL (fine for local Docker)
DIRECT_URL=
NEXT_PUBLIC_SITE_URL=
SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=           # Anthropic API key for photo menu parsing