{
  "name": "menu-go-frontend",
  "private": true,
  "description": "MENU-GO project to show restaurants menus most pretty",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "ci": "turbo run ci",
    "build": "dotenv -e .env -- turbo run build",
    "dev": "dotenv -e .env -- turbo run dev",
    "start": "turbo run start",
    "dev:docker": "docker-compose up -d",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install",
    "clean": "turbo run clean",
    "db:generate": "dotenv -e .env -- turbo run db:generate",
    "db:push": "dotenv -e .env -- turbo db:push db:generate",
    "db:seed": "dotenv -e .env -- turbo db:generate db:seed",
    "db:reset": "dotenv -e .env -- turbo db:reset",
    "db:migrate": "dotenv -e .env -- turbo db:migrate",
    "db:migrate:dev": "dotenv -e .env -- turbo db:migrate:dev",
    "build:types": "dotenv -e .env -- turbo build:types"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^11.0.3",
    "husky": "^8.0.3",
    "openai": "^4.33.0",
    "prettier": "^3.2.5",
    "semantic-release": "^22.0.12",
    "turbo": "^2.8.20"
  },
  "dependencies": {
    "@prisma/client": "^5.12.1",
    "clsx": "^2.1.0",
    "dotenv-cli": "^7.4.1",
    "nanoid": "^4.0.2"
  },
  "overrides": {
    "semver": "~7.5.2"
  },
  "packageManager": "pnpm@8.15.4"
}
