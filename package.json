{
  "name": "menu-go-frontend",
  "private": true,
  "description": "MENU-GO project to show restaurants menus most pretty",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "ci": "turbo run ci",
    "build": "dotenv -e .env -- turbo run build",
    "dev": "dotenv -e .env -- turbo run dev",
    "start": "turbo run start",
    "dev:docker": "docker-compose up -d",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install",
    "clean": "turbo run clean",
    "db:generate": "dotenv -e .env -- turbo run db:generate",
    "db:push": "dotenv -e .env -- turbo db:push db:generate",
    "db:seed": "dotenv -e .env -- turbo db:generate db:seed",
    "db:reset": "dotenv -e .env -- turbo db:reset",
    "db:migrate": "dotenv -e .env -- turbo db:migrate",
    "db:migrate:dev": "dotenv -e .env -- turbo db:migrate:dev",
    "build:types": "dotenv -e .env -- turbo build:types"
  },
  "devDependencies": {
    "@commitlint/cli": "^16.2.4",
    "@commitlint/config-conventional": "^17.4.4",
    "@semantic-release/changelog": "^6.0.2",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^9.0.2",
    "commitlint-config-jira": "^1.6.4",
    "commitlint-plugin-jira-rules": "^1.6.4",
    "husky": "^8.0.3",
    "prettier": "^2.8.4",
    "prettier-standard": "^16.4.1",
    "semantic-release": "^20.1.1",
    "turbo": "^1.9.8"
  },
  "dependencies": {
    "dotenv-cli": "^7.0.0"
  },
  "packageManager": "npm@8.19.3"
}
