{
  "name": "menu-go-frontend",
  "private": true,
  "description": "MENU-GO project to show restaurants menus most pretty",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "ci": "turbo run ci",
    "build": "dotenv -e .env -- turbo run build",
    "dev": "dotenv -e .env -- turbo run dev",
    "start": "turbo run start",
    "dev:docker": "docker-compose up -d",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "clean": "turbo run clean",
    "db:generate": "dotenv -e .env -- turbo run db:generate",
    "db:push": "dotenv -e .env -- turbo db:push db:generate",
    "db:seed": "dotenv -e .env -- turbo db:generate db:seed",
    "db:reset": "dotenv -e .env -- turbo db:reset",
    "db:migrate": "dotenv -e .env -- turbo db:migrate",
    "db:migrate:dev": "dotenv -e .env -- turbo db:migrate:dev",
    "build:types": "dotenv -e .env -- turbo build:types"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^11.0.3",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "semantic-release": "^25.0.3",
    "turbo": "^2.9.8"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "clsx": "^2.1.1",
    "dotenv-cli": "^11.0.0",
    "nanoid": "^5.1.11"
  },
  "overrides": {
    "semver": "~7.5.2"
  },
  "pnpm": {
    "overrides": {
      "minimatch@<9.0.7": ">=9.0.7",
      "picomatch": ">=4.0.4",
      "brace-expansion@<2.0.3": ">=2.0.3",
      "brace-expansion@<1.1.13": ">=1.1.13",
      "braces": ">=3.0.3",
      "ajv@<8.18.0": ">=8.18.0",
      "flatted": ">=3.4.2",
      "serialize-javascript": ">=7.0.5",
      "js-yaml@<4.1.1": ">=4.1.1",
      "cross-spawn": ">=7.0.5",
      "micromatch": ">=4.0.8",
      "@babel/helpers": ">=7.26.10",
      "postcss": ">=8.5.10",
      "glob@<10.5.0": ">=10.5.0",
      "svgo@<2.8.1": ">=2.8.1",
      "rollup@<2.79.2": ">=2.79.2 <3",
      "yaml@<2.3.0": ">=2.3.0",
      "@hono/node-server@<1.19.13": ">=1.19.13",
      "uuid@<9.0.0": ">=9.0.0"
    }
  },
  "packageManager": "pnpm@8.15.4"
}
